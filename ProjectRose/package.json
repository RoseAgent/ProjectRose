{
  "name": "projectrose",
  "version": "1.9.3",
  "description": "ProjectRose - A code editor IDE with AI chat integration",
  "author": "RoseAgent",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoseAgent/ProjectRose.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.projectrose.app",
    "productName": "ProjectRose",
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@ffmpeg-installer/**"
    ],
    "icon": "build/icon",
    "protocols": [
      {
        "name": "ProjectRose",
        "schemes": [
          "projectrose"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "RoseAgent",
      "repo": "ProjectRose"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "ProjectRose Protocol",
            "CFBundleURLSchemes": [
              "projectrose"
            ]
          }
        ],
        "NSMicrophoneUsageDescription": "ProjectRose uses the microphone for the Active Listening feature.",
        "NSCameraUsageDescription": "ProjectRose may use the camera when the chat requests screen or camera capture."
      }
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@huggingface/transformers": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^6.0.168",
    "ai-sdk-ollama": "^3.8.3",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.26.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "googleapis": "^144.0.0",
    "imapflow": "^1.3.2",
    "mailparser": "^3.9.8",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "nodemailer": "^8.0.5",
    "pyright": "^1.1.409",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rrule": "^2.8.1",
    "sonner": "^2.0.7",
    "typescript-language-server": "^4.4.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "to-ico": "^1.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^4.1.5"
  }
}
